+static bool shouldDumpCJMIOffset(const Function &F) {
+  return F.getName().equals("_CGV7default22var_1710060587481_1385Hv");
+}
+
+static int getMemoryOperandStartIdx(const MachineInstr &MI) {
+  const MCInstrDesc &Desc = MI.getDesc();
+  for (unsigned I = Desc.NumDefs; I < Desc.getNumOperands(); ++I) {
+    if (Desc.OpInfo[I].OperandType == MCOI::OPERAND_MEMORY)
+      return I;
+  }
+  return -1;
+}
+
+static bool decodeMemoryByteOffset(const MachineInstr &MI, unsigned MemOpIdx,
+                                   int64_t &ByteOffset) {
+  ARMII::AddrMode AddrMode =
+      ARMII::AddrMode(MI.getDesc().TSFlags & ARMII::AddrModeMask);
+
+  switch (AddrMode) {
+  case ARMII::AddrMode2: {
+    const MachineOperand &OffsetReg = MI.getOperand(MemOpIdx + 1);
+    const MachineOperand &OffsetImm = MI.getOperand(MemOpIdx + 2);
+    if (!OffsetReg.isReg() || !OffsetImm.isImm() || OffsetReg.getReg() != 0)
+      return false;
+    ByteOffset = ARM_AM::getAM2Offset(OffsetImm.getImm());
+    if (ARM_AM::getAM2Op(OffsetImm.getImm()) == ARM_AM::sub)
+      ByteOffset = -ByteOffset;
+    return true;
+  }
+  case ARMII::AddrMode3: {
+    const MachineOperand &OffsetReg = MI.getOperand(MemOpIdx + 1);
+    const MachineOperand &OffsetImm = MI.getOperand(MemOpIdx + 2);
+    if (!OffsetReg.isReg() || !OffsetImm.isImm() || OffsetReg.getReg() != 0)
+      return false;
+    ByteOffset = ARM_AM::getAM3Offset(OffsetImm.getImm());
+    if (ARM_AM::getAM3Op(OffsetImm.getImm()) == ARM_AM::sub)
+      ByteOffset = -ByteOffset;
+    return true;
+  }
+  case ARMII::AddrMode5: {
+    const MachineOperand &OffsetImm = MI.getOperand(MemOpIdx + 1);
+    if (!OffsetImm.isImm())
+      return false;
+    ByteOffset = ARM_AM::getAM5Offset(OffsetImm.getImm()) * 4;
+    if (ARM_AM::getAM5Op(OffsetImm.getImm()) == ARM_AM::sub)
+      ByteOffset = -ByteOffset;
+    return true;
+  }
+  case ARMII::AddrMode5FP16: {
+    const MachineOperand &OffsetImm = MI.getOperand(MemOpIdx + 1);
+    if (!OffsetImm.isImm())
+      return false;
+    ByteOffset = ARM_AM::getAM5FP16Offset(OffsetImm.getImm()) * 2;
+    if (ARM_AM::getAM5FP16Op(OffsetImm.getImm()) == ARM_AM::sub)
+      ByteOffset = -ByteOffset;
+    return true;
+  }
+  case ARMII::AddrModeT1_1:
+    if (!MI.getOperand(MemOpIdx + 1).isImm())
+      return false;
+    ByteOffset = MI.getOperand(MemOpIdx + 1).getImm();
+    return true;
+  case ARMII::AddrModeT1_2:
+    if (!MI.getOperand(MemOpIdx + 1).isImm())
+      return false;
+    ByteOffset = MI.getOperand(MemOpIdx + 1).getImm() * 2;
+    return true;
+  case ARMII::AddrModeT1_4:
+  case ARMII::AddrModeT1_s:
+    if (!MI.getOperand(MemOpIdx + 1).isImm())
+      return false;
+    ByteOffset = MI.getOperand(MemOpIdx + 1).getImm() * 4;
+    return true;
+  case ARMII::AddrModeT2_i12:
+  case ARMII::AddrModeT2_i8:
+  case ARMII::AddrModeT2_i8pos:
+  case ARMII::AddrModeT2_i8neg:
+  case ARMII::AddrModeT2_i8s4:
+  case ARMII::AddrMode_i12:
+  case ARMII::AddrModeT2_i7:
+  case ARMII::AddrModeT2_i7s2:
+  case ARMII::AddrModeT2_i7s4:
+    if (!MI.getOperand(MemOpIdx + 1).isImm())
+      return false;
+    ByteOffset = MI.getOperand(MemOpIdx + 1).getImm();
+    return true;
+  case ARMII::AddrModeT2_ldrex:
+    if (!MI.getOperand(MemOpIdx + 1).isImm())
+      return false;
+    ByteOffset = MI.getOperand(MemOpIdx + 1).getImm() * 4;
+    return true;
+  default:
+    return false;
+  }
+}
+
+static void dumpFinalMemoryInstructionOffset(const MachineInstr &MI) {
+  const Function &F = MI.getParent()->getParent()->getFunction();
+  if (!shouldDumpCJMIOffset(F) || (!MI.mayLoad() && !MI.mayStore()))
+    return;
+
+  errs() << "llc final mem function: " << F.getName() << "\n";
+  errs() << "llc final mem bb: " << MI.getParent()->getName() << "\n";
+  errs() << "llc final mem mi: ";
+  MI.print(errs());
+  errs() << "\n";
+
+  ARMII::AddrMode AddrMode =
+      ARMII::AddrMode(MI.getDesc().TSFlags & ARMII::AddrModeMask);
+  errs() << "llc final mem addrmode: " << ARMII::AddrModeToString(AddrMode)
+         << "\n";
+
+  int MemOpIdx = getMemoryOperandStartIdx(MI);
+  if (MemOpIdx >= 0) {
+    int64_t ByteOffset = 0;
+    if (decodeMemoryByteOffset(MI, MemOpIdx, ByteOffset))
+      errs() << "llc final mem immediate byte offset: " << ByteOffset << "\n";
+    else
+      errs() << "llc final mem immediate byte offset: <non-immediate or "
+                "unsupported>\n";
+  } else {
+    errs() << "llc final mem immediate byte offset: <no memory operand>\n";
+  }
+
+  for (const MachineMemOperand *MMO : MI.memoperands()) {
+    errs() << "llc final mem mmo offset: " << MMO->getOffset() << "\n";
+    if (const Value *V = MMO->getValue()) {
+      errs() << "llc final mem mmo value: ";
+      V->printAsOperand(errs(), false);
+      errs() << "\n";
+    }
+  }
+}
+
