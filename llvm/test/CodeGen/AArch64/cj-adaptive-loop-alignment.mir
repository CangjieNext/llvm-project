# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=generic -cangjie-pipeline -verify-machineinstrs -run-pass=block-placement %s -o - | FileCheck %s --check-prefix=GENERIC
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -cangjie-pipeline -verify-machineinstrs -start-before=block-placement %s -o - | FileCheck %s --check-prefix=ASM
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -cangjie-pipeline -verify-machineinstrs -start-before=block-placement -max-bytes-for-alignment=8 %s -o - | FileCheck %s --check-prefix=MAXASM
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -verify-machineinstrs -run-pass=block-placement -cangjie-pipeline %s -o - | FileCheck %s --check-prefix=ADAPT
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -verify-machineinstrs -run-pass=block-placement %s -o - | FileCheck %s --check-prefix=DEFAULT
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -verify-machineinstrs -run-pass=block-placement -cangjie-pipeline -cj-adaptive-loop-alignment=false %s -o - | FileCheck %s --check-prefix=DEFAULT
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -verify-machineinstrs -run-pass=block-placement -cangjie-pipeline -align-loops=128 %s -o - | FileCheck %s --check-prefix=EXPLICIT
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -verify-machineinstrs -run-pass=block-placement -cangjie-pipeline -align-loops=1 %s -o - | FileCheck %s --check-prefix=NONE
# RUN: llc -mtriple=aarch64-linux-gnu -mcpu=cortex-a53 -verify-machineinstrs -run-pass=block-placement -cangjie-pipeline -align-all-blocks=3 %s -o - | FileCheck %s --check-prefix=ALL

# The loop bodies contain 8, 16, 20, 32, 36, 64 and 68 bytes, including
# the decrement and backedge. Test both sides of each alignment boundary.
# Meta instructions emit no bytes; inline assembly may contain directives
# whose size depends on its address and must retain the ordinary policy.
--- |
  define void @loop8(i64 %n)  { ret void }
  define void @loop16(i64 %n)  { ret void }
  define void @loop20(i64 %n)  { ret void }
  define void @loop32(i64 %n)  { ret void }
  define void @loop36(i64 %n)  { ret void }
  define void @loop64(i64 %n)  { ret void }
  define void @loop68(i64 %n)  { ret void }
  define void @minsize_loop(i64 %n) minsize { ret void }
  define void @optsize_loop(i64 %n) optsize { ret void }
  define void @meta_loop(i64 %n)  { ret void }
  define void @inline_asm_loop(i64 %n)  { ret void }
...

---
name: loop8
# GENERIC-LABEL: name: loop8
# GENERIC: bb.1 (align 16):
# ASM-LABEL: loop8:
# MAXASM-LABEL: loop8:
# ASM: .p2align 4{{$}}
# MAXASM: .p2align 4, 0x0, 8{{$}}
# ASM: b.ne
# MAXASM: b.ne
tracksRegLiveness: true
# ADAPT-LABEL: name: loop8
# ADAPT: bb.1 (align 16):
# DEFAULT-LABEL: name: loop8
# DEFAULT: bb.1 (align 16):
# EXPLICIT-LABEL: name: loop8
# EXPLICIT: bb.1 (align 128):
# NONE-LABEL: name: loop8
# NONE: bb.1:
# ALL-LABEL: name: loop8
# ALL: bb.1 (align 8):
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x0

    $x0 = SUBSXri $x0, 1, 0, implicit-def $nzcv
    Bcc 1, %bb.1, implicit $nzcv

  bb.2:
    RET undef $lr
...

---
name: loop16
# GENERIC-LABEL: name: loop16
# GENERIC: bb.1 (align 16):
# ASM-LABEL: loop16:
# MAXASM-LABEL: loop16:
# ASM: .p2align 4{{$}}
# MAXASM: .p2align 4, 0x0, 8{{$}}
# ASM: b.ne
# MAXASM: b.ne
tracksRegLiveness: true
# ADAPT-LABEL: name: loop16
# ADAPT: bb.1 (align 16):
# DEFAULT-LABEL: name: loop16
# DEFAULT: bb.1 (align 16):
# EXPLICIT-LABEL: name: loop16
# EXPLICIT: bb.1 (align 128):
# NONE-LABEL: name: loop16
# NONE: bb.1:
# ALL-LABEL: name: loop16
# ALL: bb.1 (align 8):
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x0

    HINT 0
    HINT 0
    $x0 = SUBSXri $x0, 1, 0, implicit-def $nzcv
    Bcc 1, %bb.1, implicit $nzcv

  bb.2:
    RET undef $lr
...

