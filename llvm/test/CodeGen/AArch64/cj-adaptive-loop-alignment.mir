---
name: meta_loop
# GENERIC-LABEL: name: meta_loop
# GENERIC: bb.1 (align 16):
# ASM-LABEL: meta_loop:
# MAXASM-LABEL: meta_loop:
# ASM: .p2align 4{{$}}
# MAXASM: .p2align 4, 0x0, 8{{$}}
# ASM: b.ne
# MAXASM: b.ne
tracksRegLiveness: true
# ADAPT-LABEL: name: meta_loop
# ADAPT: bb.1 (align 16):
# DEFAULT-LABEL: name: meta_loop
# DEFAULT: bb.1 (align 16):
# EXPLICIT-LABEL: name: meta_loop
# EXPLICIT: bb.1 (align 128):
# NONE-LABEL: name: meta_loop
# NONE: bb.1:
# ALL-LABEL: name: meta_loop
# ALL: bb.1 (align 8):
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x0

    CFI_INSTRUCTION def_cfa_offset 0
    HINT 0
    HINT 0
    $x0 = SUBSXri $x0, 1, 0, implicit-def $nzcv
    Bcc 1, %bb.1, implicit $nzcv

  bb.2:
    RET undef $lr
...

---
name: inline_asm_loop
# GENERIC-LABEL: name: inline_asm_loop
# GENERIC: bb.1:
# ASM-LABEL: inline_asm_loop:
# MAXASM-LABEL: inline_asm_loop:
# ASM: .p2align 4, 0x0, 8{{$}}
# MAXASM: .p2align 4, 0x0, 8{{$}}
# ASM: b.ne
# MAXASM: b.ne
tracksRegLiveness: true
# ADAPT-LABEL: name: inline_asm_loop
# ADAPT: bb.1 (align 16):
# DEFAULT-LABEL: name: inline_asm_loop
# DEFAULT: bb.1 (align 16):
# EXPLICIT-LABEL: name: inline_asm_loop
# EXPLICIT: bb.1 (align 128):
# NONE-LABEL: name: inline_asm_loop
# NONE: bb.1:
# ALL-LABEL: name: inline_asm_loop
# ALL: bb.1 (align 8):
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x0

    INLINEASM &".p2align 7", 1
    HINT 0
    HINT 0
    $x0 = SUBSXri $x0, 1, 0, implicit-def $nzcv
    Bcc 1, %bb.1, implicit $nzcv

  bb.2:
    RET undef $lr
...
